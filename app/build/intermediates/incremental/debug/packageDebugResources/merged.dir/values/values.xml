<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launch_background">#FDF9FE</color>
    <color name="launch_dark">#0A0B10</color>
    <color name="launch_light">#FDF9FE</color>
    <style name="Theme.Nodx" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Nodx.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Nodx.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>